<!-- Hero Section -->
<section id="home">
    <div class="container">
        <div class="row align-items-center g-5">

            <!-- Left Content -->
            <div class="col-lg-7 reveal-on-scroll">

                <!-- Dynamic Greeting -->
                <div class="hero-badge">
                    <span>👋</span> @ViewBag.v1
                </div>

                <!-- Name -->
                <h1 class="hero-title">
                    Merhaba, Ben
                    <span class="hero-name-gradient">
                        Yaren Kasımoğlu
                    </span>
                </h1>

                <!-- Dynamic Job Title -->
                @if (ViewBag.v2 != null)
                {
                    <p class="fs-5 fw-semibold text-primary">
                        @ViewBag.v2
                    </p>
                }

                <!-- Animated Typing Text Slider -->
                <div class="typing-container" aria-live="polite">
                    <span id="typedText"></span>
                    <span class="typing-cursor"></span>
                </div>

                <!-- Dynamic Description -->
                <p class="hero-desc">
                    @ViewBag.v3
                </p>

                <!-- Action Buttons -->
                <div class="d-flex flex-wrap gap-3 align-items-center mb-4">

                    <a href="#projects" class="btn-custom-primary">
                        <i class="bi bi-grid-fill"></i>
                        Projelerimi İncele
                    </a>

                    <a href="#contact" class="btn-custom-outline">
                        <i class="bi bi-chat-dots"></i>
                        Benimle İletişime Geç
                    </a>

                </div>

            </div>

            <!-- Right Visual -->
            <div class="col-lg-5 reveal-on-scroll">

                <div class="hero-image-wrapper">

                    <!-- Floating Badge Top Left -->
                    <div class="floating-card float-top-left">

                        <div class="float-icon-box bg-icon-purple">
                            <i class="bi bi-code-slash"></i>
                        </div>

                        <div>
                            <div class="fw-bold small text-dark">
                                Clean Code
                            </div>

                            <div class="text-secondary"
                                 style="font-size: 0.72rem;">
                                C# & ASP.NET Core
                            </div>
                        </div>

                    </div>

                    <!-- Dynamic Portrait -->
                    <div class="hero-image-frame">
                        @if (!string.IsNullOrWhiteSpace(ViewBag.v4 as string))
                        {
                            <img src="@ViewBag.v4"
                                 alt="Yaren Kasımoğlu - Bilgisayar Mühendisi"
                                 loading="lazy">
                        }
                    </div>

                    <!-- Floating Badge Bottom Right -->
                    <div class="floating-card float-bottom-right">

                        <div class="float-icon-box bg-icon-mint">
                            <i class="bi bi-laptop"></i>
                        </div>

                        <div>
                            <div class="fw-bold small text-dark">
                                Software Engineer
                            </div>

                            <div class="text-secondary"
                                 style="font-size: 0.72rem;">
                                Full Stack Developer
                            </div>
                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>
</section>
