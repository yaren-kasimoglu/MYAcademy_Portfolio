
@model List<MYAcademy_Portfolio.Entities.Education>

<section id="education" style="background-color: var(--bg-secondary);">
    <div class="container">

        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">AKADEMİK YOLCULUĞUM</span>
        </div>

        <div class="timeline-container">

            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                bool isLeft = i % 2 == 0;

                <div class="timeline-item row align-items-center g-4 reveal-on-scroll">

                    @if (isLeft)
                    {
                        <div class="col-lg-6 timeline-left order-2 order-lg-1">
                        
<div class="timeline-content-card">

    <div class="mb-3">
        <span class="badge-year bg-icon-purple">
            <i class="bi bi-calendar3"></i>
            @item.Duration
        </span>
    </div>

    <h4 class="fs-5 fw-bold mb-2">
        @item.Title
    </h4>

    <div class="text-primary fw-semibold small mb-3">
        @item.SubTitle
    </div>

    <p class="text-secondary small mb-0">
        @item.Description
    </p>

</div>

                        </div>

                        <div class="timeline-marker">
                            <i class="bi bi-mortarboard"></i>
                        </div>

                        <div class="col-lg-6 timeline-right order-1 order-lg-2 d-none d-lg-block">
                        </div>
                    }
                    else
                    {
                        <div class="col-lg-6 timeline-left d-none d-lg-block">
                        </div>

                        <div class="timeline-marker">
                            <i class="bi bi-book"></i>
                        </div>

                        <div class="col-lg-6 timeline-right">
                         
<div class="timeline-content-card">

    <div class="mb-3">
        <span class="badge-year bg-icon-mint">
            <i class="bi bi-calendar3"></i>
            @item.Duration
        </span>
    </div>

    <h4 class="fs-5 fw-bold mb-2">
        @item.Title
    </h4>

    <div class="text-primary fw-semibold small mb-3">
        @item.SubTitle
    </div>

    <p class="text-secondary small mb-0">
        @item.Description
    </p>

</div>

                        </div>
                    }

                </div>
            }

        </div>
    </div>
</section>
