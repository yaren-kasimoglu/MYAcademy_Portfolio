@model MYAcademy_Portfolio.Entities.Project

@{
    ViewData["Title"] = "Proje Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid">
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h4 class="mb-0">Proje Güncelle</h4>
        </div>

        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="Project"
                  asp-action="UpdateProject"
                  asp-route-id="@Model.ProjectId"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="ProjectId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">
                        Proje Adı
                    </label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Proje Açıklaması
                    </label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">
                        Kategori
                    </label>

                    <select asp-for="CategoryId"
                            asp-items="ViewBag.Categories"
                            class="form-select">
                        <option value="">Kategori seçiniz</option>
                    </select>

                    <span asp-validation-for="CategoryId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GithubUrl" class="form-label">
                        GitHub Linki
                    </label>
                    <input asp-for="GithubUrl"
                           class="form-control"
                           placeholder="https://github.com/..." />
                </div>

                <div class="mb-3">
                    <label asp-for="CoverImageUrl" class="form-label">
                        Proje Görseli URL
                    </label>

                    <input asp-for="CoverImageUrl"
                           class="form-control" />

                    <div class="form-text">
                        Mevcut görselin yolunu değiştirebilirsiniz.
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                {
                    <div class="mb-3">
                        <label class="form-label">
                            Mevcut Görsel
                        </label>

                        <div>
                            <img src="@Model.CoverImageUrl"
                                 alt="Proje görseli"
                                 class="img-thumbnail"
                                 style="max-width:220px;" />
                        </div>
                    </div>
                }

                <div class="form-check form-switch mb-4">
                    <input asp-for="IsActive"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="IsActive"
                           class="form-check-label">
                        Proje aktif
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-check-circle"></i>
                        Değişiklikleri Kaydet
                    </button>

                    <a asp-area="Admin"
                       asp-controller="Project"
                       asp-action="ProjectList"
                       class="btn btn-secondary">
                        İptal
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>
