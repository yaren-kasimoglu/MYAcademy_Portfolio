@model MYAcademy_Portfolio.Entities.Project

@{
    ViewData["Title"] = "Yeni Proje Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<form asp-area="Admin"
      asp-controller="Project"
      asp-action="CreateProject"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label">Proje Adı</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Açıklama</label>
        <textarea asp-for="Description"
                  class="form-control"
                  rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Kategori</label>
        <select asp-for="CategoryId"
                asp-items="ViewBag.Categories"
                class="form-select">
            <option value="0">Kategori Seçiniz</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="GithubUrl" class="form-label">GitHub URL</label>
        <input asp-for="GithubUrl" class="form-control" />
    </div>


    <div class="mb-3">
        <label class="form-label">Proje Görseli</label>
        <input type="file"
               name="imageFile"
               class="form-control"
               accept=".jpg,.jpeg,.png,.webp" />
        <small class="text-muted">
            JPG, PNG veya WEBP. En fazla 5 MB.
        </small>
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-circle"></i> Kaydet
    </button>

    <a asp-area="Admin"
       asp-controller="Project"
       asp-action="ProjectList"
       class="btn btn-secondary">
        İptal
    </a>
</form>
