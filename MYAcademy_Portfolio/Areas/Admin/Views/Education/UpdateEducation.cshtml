@model MYAcademy_Portfolio.Entities.Education

@{
    ViewData["Title"] = "Eğitim Bilgisi Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<h2 class="mb-4">Eğitim Bilgisi Güncelle</h2>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0">Eğitim Bilgilerini Düzenle</h5>
    </div>

    <div class="card-body">
        <form asp-area="Admin"
              asp-controller="Education"
              asp-action="UpdateEducation"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="EducationId" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">
                    Okul / Üniversite Adı
                </label>
                <input asp-for="Title"
                       class="form-control" />
                <span asp-validation-for="Title"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SubTitle" class="form-label">
                    Bölüm
                </label>
                <input asp-for="SubTitle"
                       class="form-control" />
                <span asp-validation-for="SubTitle"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Duration" class="form-label">
                    Eğitim Süresi
                </label>
                <input asp-for="Duration"
                       class="form-control"
                       placeholder="Örn: 2020 - 2024" />
                <span asp-validation-for="Duration"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">
                    Açıklama
                </label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="5"></textarea>
                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-1"></i>
                    Güncelle
                </button>

                <a asp-area="Admin"
                   asp-controller="Education"
                   asp-action="EducationList"
                   class="btn btn-secondary">
                    İptal
                </a>
            </div>

        </form>
    </div>
</div>
