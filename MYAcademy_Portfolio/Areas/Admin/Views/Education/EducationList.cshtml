@model List<MYAcademy_Portfolio.Entities.Education>

@{
    ViewData["Title"] = "Eğitim Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<h2>Eğitim Yönetimi</h2>

<a asp-area="Admin"
   asp-controller="Education"
   asp-action="CreateEducation"
   class="btn btn-primary mb-3">
    + Yeni Eğitim Ekle
</a>

<div class="card">
    <div class="card-body">
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Okul Adı</th>
                    <th>Bölüm</th>
                    <th>Açıklama</th>
                    <th>Eğitim Süresi</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.SubTitle</td>
                            <td>@item.Description</td>
                            <td>@item.Duration</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-area="Admin"
                                       asp-controller="Education"
                                       asp-action="UpdateEducation"
                                       asp-route-id="@item.EducationId"
                                       class="btn btn-warning btn-sm">
                                        Güncelle
                                    </a>

                                    <form asp-area="Admin"
                                          asp-controller="Education"
                                          asp-action="DeleteEducation"
                                          asp-route-id="@item.EducationId"
                                          method="post"
                                          onsubmit="return confirm('Bu eğitimi silmek istediğinize emin misiniz?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Sil
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">
                            Henüz eğitim bilgisi eklenmemiş.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
