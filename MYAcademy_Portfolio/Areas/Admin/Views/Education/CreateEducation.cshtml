@model MYAcademy_Portfolio.Entities.Education

@{
    ViewData["Title"] = "Yeni Eğitim Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<h2 class="mb-4">Yeni Eğitim Ekle</h2>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Yeni Eğitim Bilgisi</h5>
    </div>

    <div class="card-body">
        <form asp-area="Admin"
              asp-controller="Education"
              asp-action="CreateEducation"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">
                    Okul / Üniversite Adı
                </label>
                <input asp-for="Title"
                       class="form-control"
                       placeholder="Örn: Kocaeli Üniversitesi" />
                <span asp-validation-for="Title"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SubTitle" class="form-label">
                    Bölüm
                </label>
                <input asp-for="SubTitle"
                       class="form-control"
                       placeholder="Örn: Bilgisayar Mühendisliği" />
                <span asp-validation-for="SubTitle"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Duration" class="form-label">
                    Eğitim Süresi
                </label>
                <input asp-for="Duration"
                       class="form-control"
                       placeholder="Örn: 2020 - 2024" />
                <span asp-validation-for="Duration"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">
                    Açıklama
                </label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="5"
                          placeholder="Eğitim hakkında açıklama yazınız..."></textarea>
                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Kaydet
                </button>

                <a asp-area="Admin"
                   asp-controller="Education"
                   asp-action="EducationList"
                   class="btn btn-secondary">
                    Geri Dön
                </a>
            </div>

        </form>
    </div>
</div>
