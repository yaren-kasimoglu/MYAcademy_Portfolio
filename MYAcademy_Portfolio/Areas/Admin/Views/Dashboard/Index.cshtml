@model MYAcademy_Portfolio.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<style>
    .dash {
        font-family: "Segoe UI", Roboto, Arial, sans-serif;
        color: #1f2937;
        padding: 8px 4px 24px;
    }

        .dash * {
            box-sizing: border-box;
        }

    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 24px;
    }

        .dash-header h1 {
            font-size: 26px;
            font-weight: 700;
            margin: 0;
        }

        .dash-header p {
            margin: 4px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

    .dash-btn {
        background: #4f46e5;
        color: #fff;
        border: none;
        padding: 9px 16px;
        border-radius: 8px;
        font-size: 14px;
        text-decoration: none;
        display: inline-block;
    }

        .dash-btn:hover {
            background: #4338ca;
            color: #fff;
        }

    .dash-grid {
        display: grid;
        gap: 20px;
    }

    .dash-stats {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
        margin-bottom: 20px;
    }

    .dash-main {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
        margin-bottom: 20px;
    }

    .dash-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, .04);
        min-width: 0;
    }

        .dash-card h3 {
            font-size: 16px;
            font-weight: 600;
            margin: 0 0 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

            .dash-card h3 a {
                font-size: 13px;
                font-weight: 500;
                color: #4f46e5;
                text-decoration: none;
            }

    .stat {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .stat-label {
        font-size: 13px;
        color: #6b7280;
        margin: 0;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        margin: 2px 0 0;
        line-height: 1.1;
    }

    .stat-sub {
        font-size: 12px;
        color: #9ca3af;
        margin-top: 4px;
    }

    .bg-indigo {
        background: #eef2ff;
        color: #4f46e5;
    }

    .bg-green {
        background: #ecfdf5;
        color: #059669;
    }

    .bg-amber {
        background: #fffbeb;
        color: #d97706;
    }

    .bg-sky {
        background: #f0f9ff;
        color: #0284c7;
    }

    .progress-row {
        margin-bottom: 18px;
    }

        .progress-row:last-child {
            margin-bottom: 0;
        }

    .progress-top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        font-size: 14px;
        margin-bottom: 6px;
    }

        .progress-top span:last-child {
            color: #6b7280;
        }

    .dash-progress-bar {
        height: 10px;
        background: #f3f4f6;
        border-radius: 99px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        border-radius: 99px;
    }

    .fill-green {
        background: #10b981;
    }

    .dash-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .dash-table th {
            text-align: left;
            font-weight: 600;
            color: #6b7280;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .03em;
            padding: 10px 12px;
            border-bottom: 1px solid #e5e7eb;
            background: #f9fafb;
        }

        .dash-table td {
            padding: 12px;
            border-bottom: 1px solid #f3f4f6;
            vertical-align: middle;
        }

        .dash-table tr:last-child td {
            border-bottom: none;
        }

        .dash-table tr:hover td {
            background: #fafafa;
        }

    .dash-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #e0e7ff;
        color: #4338ca;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 13px;
        margin-right: 10px;
        flex-shrink: 0;
    }

    .name-cell {
        display: flex;
        align-items: center;
    }

    .muted {
        color: #6b7280;
        font-size: 13px;
    }

    .dash .badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 99px;
        font-size: 12px;
        font-weight: 600;
    }

    .dash .badge-read {
        background: #ecfdf5;
        color: #047857;
    }

    .dash .badge-unread {
        background: #fef3c7;
        color: #b45309;
    }

    .table-scroll {
        overflow-x: auto;
    }

    .quick-links {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

        .quick-links a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            color: #1f2937;
            text-decoration: none;
            font-size: 14px;
        }

            .quick-links a:hover {
                border-color: #4f46e5;
                background: #f5f7ff;
            }

    @@media (max-width: 600px) {
        .dash-main {
            grid-template-columns: 1fr;
        }

        .quick-links {
            grid-template-columns: 1fr;
        }

        .dash-card {
            padding: 16px;
        }
    }
</style>

<div class="dash">

    <!-- Dashboard başlığı -->
    <div class="dash-header">
        <div>
            <h1>Dashboard</h1>
            <p>Hoş geldiniz! Portfolyo sitenizin genel durumu aşağıda.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Message"
           asp-action="MessageList"
           class="dash-btn">
            ✉ Tüm Mesajlar
        </a>
    </div>

    <!-- İstatistik kartları -->
    <div class="dash-grid dash-stats">

        <div class="dash-card stat">
            <div class="stat-icon bg-indigo">📁</div>
            <div>
                <p class="stat-label">Toplam Proje</p>
                <p class="stat-value">@Model.TotalProjects</p>
                <div class="stat-sub">Tüm projeler</div>
            </div>
        </div>

        <div class="dash-card stat">
            <div class="stat-icon bg-green">✔</div>
            <div>
                <p class="stat-label">Aktif Proje</p>
                <p class="stat-value">@Model.ActiveProjects</p>
                <div class="stat-sub">Yayındaki projeler</div>
            </div>
        </div>

        <div class="dash-card stat">
            <div class="stat-icon bg-sky">🛠</div>
            <div>
                <p class="stat-label">Yetenek</p>
                <p class="stat-value">@Model.TotalSkills</p>
                <div class="stat-sub">Kayıtlı yetenekler</div>
            </div>
        </div>

        <div class="dash-card stat">
            <div class="stat-icon bg-indigo">💼</div>
            <div>
                <p class="stat-label">Deneyim</p>
                <p class="stat-value">@Model.TotalExperiences</p>
                <div class="stat-sub">Kayıtlı deneyimler</div>
            </div>
        </div>

        <div class="dash-card stat">
            <div class="stat-icon bg-sky">🎓</div>
            <div>
                <p class="stat-label">Eğitim</p>
                <p class="stat-value">@Model.TotalEducations</p>
                <div class="stat-sub">Kayıtlı eğitimler</div>
            </div>
        </div>

        <div class="dash-card stat">
            <div class="stat-icon bg-indigo">✉</div>
            <div>
                <p class="stat-label">Toplam Mesaj</p>
                <p class="stat-value">@Model.TotalMessages</p>
                <div class="stat-sub">Tüm zamanlar</div>
            </div>
        </div>

        <div class="dash-card stat">
            <div class="stat-icon bg-amber">●</div>
            <div>
                <p class="stat-label">Okunmamış Mesaj</p>
                <p class="stat-value">@Model.UnreadMessages</p>
                <div class="stat-sub">İlgilenilmesi gerekenler</div>
            </div>
        </div>

    </div>

    <!-- Son 5 mesaj -->
    <div class="dash-card" style="margin-bottom:20px;">

        <h3>
            Son 5 Mesaj

            <a asp-area="Admin"
               asp-controller="Message"
               asp-action="MessageList">
                Tümünü gör →
            </a>
        </h3>

        <div class="table-scroll">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Gönderen</th>
                        <th>Konu</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th>Detay</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.RecentMessages.Any())
                    {
                        <tr>
                            <td colspan="5" class="muted">
                                Henüz mesaj yok.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var message in Model.RecentMessages)
                        {
                            <tr>
                                <td>
                                    <div class="name-cell">
                                        <span class="dash-avatar">✉</span>
                                        <div>
                                            @message.NameSurname
                                            <div class="muted">
                                                @message.Email
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>@message.Subject</td>

                                <td class="muted">
                                    @message.SendDate.ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td>
                                    <span class="badge @(message.IsRead ? "badge-read" : "badge-unread")">
                                        @(message.IsRead ? "Okundu" : "Okunmadı")
                                    </span>
                                </td>

                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="Message"
                                       asp-action="MessageDetail"
                                       asp-route-id="@message.MessageId"
                                       class="btn btn-sm btn-outline-primary">
                                        Görüntüle
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Son 3 proje ve kategori özeti -->
    <div class="dash-grid dash-main">

        <div class="dash-card">
            <h3>Son 3 Proje</h3>

            <div class="table-scroll">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Proje</th>
                            <th>Kategori</th>
                            <th>Durum</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.RecentProjects.Any())
                        {
                            <tr>
                                <td colspan="4" class="muted">
                                    Henüz proje yok.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var project in Model.RecentProjects)
                            {
                                <tr>
                                    <td>@project.Title</td>

                                    <td>
                                        @(project.Category?.CategoryName ?? "Kategori yok")
                                    </td>

                                    <td>
                                        <span class="badge @(project.IsActive ? "badge-read" : "badge-unread")">
                                            @(project.IsActive ? "Aktif" : "Pasif")
                                        </span>
                                    </td>

                                    <td>
                                        <a asp-area="Admin"
                                           asp-controller="Project"
                                           asp-action="UpdateProject"
                                           asp-route-id="@project.ProjectId"
                                           class="btn btn-sm btn-outline-primary">
                                            Düzenle
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="dash-card">
            <h3>Kategori Özeti</h3>

            @if (!Model.CategoryCounts.Any())
            {
                <p class="muted">Henüz kategori yok.</p>
            }
            else
            {
                @foreach (var category in Model.CategoryCounts)
                {
                    <div class="progress-row">
                        <div class="progress-top">
                            <span>@category.CategoryName</span>
                            <span>@category.ProjectCount proje</span>
                        </div>

                        <div class="dash-progress-bar">
                            <div class="progress-fill fill-green"
                                 style="width:@(Model.TotalProjects > 0 ? category.ProjectCount * 100.0 / Model.TotalProjects : 0)%">
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

    </div>

    <!-- Hızlı erişim -->
    <div class="dash-card">
        <h3>Hızlı Erişim</h3>

        <div class="quick-links">

            <a asp-area="Admin"
               asp-controller="Project"
               asp-action="CreateProject">
                ➕ Yeni Proje Ekle
            </a>

            <a asp-area="Admin"
               asp-controller="Message"
               asp-action="MessageList">
                ✉ Mesajları Görüntüle
            </a>

            <a asp-area=""
               asp-controller="Default"
               asp-action="Index"
               target="_blank"
               rel="noopener noreferrer">
                🌐 Portfolyoyu Aç
            </a>

        </div>
    </div>

</div>
